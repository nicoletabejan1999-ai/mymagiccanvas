{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)\\.(html|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/stripe-webhook.js": {
      "includeFiles": "assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?mode=authorization-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?mode=resource-metadata"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth?mode=authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth?mode=token"
    }
  ]
}
